<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tier A advertisement decoding (PROJECT.md §13.4/§23); never used to derive location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Device metadata and the Tier B L2CAP channel (§13.5/§23). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Requested from HomeScreen once connected (M5, §23 minimum-permission rule); see
         core.bluetooth.RequiredPermissions.hasNotificationPermission and
         feature.notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Telephony permissions for Head Gesture call answering/declining (§33 Milestone 4). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Normal permission, auto-granted; lets AirPodsPresenceService be bound only while the
         associated device is in range (§13.4 point 1), no polling needed. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />

    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="true" />

    <application
        android:name=".AndroidpodsApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Androidpods">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Androidpods">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Material 3 Expressive Battery Pop-up translucent dialog activity -->
        <activity
            android:name="dev.androidpods.feature.popup.BatteryPopupActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Androidpods.Popup" />

        <service
            android:name="dev.androidpods.core.bluetooth.AirPodsPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- M5 battery widget (§32): read-only, no config activity; see feature.widgets. -->
        <receiver
            android:name="dev.androidpods.feature.widgets.BatteryWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <!-- M5 Quick Settings tile (§33): battery and quick launcher; see feature.tiles. -->
        <service
            android:name="dev.androidpods.feature.tiles.AirPodsTileService"
            android:exported="true"
            android:icon="@drawable/ic_airpods_case"
            android:label="@string/tile_airpods_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
