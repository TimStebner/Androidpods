<!-- Two-bud AirPods silhouette, same visual language as DeviceIllustration.kt's drawAirPod
     (head circle + capsule stem, mirrored, tilted outward), redrawn as a static vector since
     adaptive-icon layers can't share Compose draw code. Kept inside the 66dp safe zone
     (centered in the 108dp viewport) so launchers that mask/parallax it don't clip the shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="42"
        android:pivotY="40"
        android:rotation="-14">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M31,40 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M38,50 A4,4 0 1,1 46,50 L46,70 A4,4 0 1,1 38,70 Z" />
    </group>
    <group
        android:pivotX="66"
        android:pivotY="40"
        android:rotation="14">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M55,40 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M62,50 A4,4 0 1,1 70,50 L70,70 A4,4 0 1,1 62,70 Z" />
    </group>
</vector>
